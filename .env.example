# Copy this file to ".env" and fill in the values (used by run_local.py).

# From @BotFather in Telegram (REQUIRED)
BOT_TOKEN=123456:ABC-your-bot-token

# Your Telegram channel/group id, e.g. -1004473967915 (REQUIRED)
CHANNEL_ID=-1004473967915

# How often to check, in minutes
INTERVAL_MINUTES=10

# Which GitHub repo holds domains.json / mentions.json (edited via the panel)
GH_OWNER=rexlads
GH_REPO=trustpositif-bot
GH_BRANCH=main

# Official checker endpoint ({domain} is replaced). Adjust after `--test`.
OFFICIAL_CHECK_URL=https://trustpositif.komdigi.go.id/api/cek?url={domain}

# Set to 1 to only report blocked/problem domains
ONLY_BLOCKED=0
